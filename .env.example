# 复制为 .env 后填入你的真实密钥；生产请使用配置中心 / K8s Secret
# === 必填 ===
DASHSCOPE_API_KEY=sk-xxxxx                # 阿里云百炼/DashScope，Chat + Embedding + 云知识库 RAG

# === 可选 ===
DASHSCOPE_CHAT_MODEL=qwen-plus            # 默认 qwen-plus，可改 qwen-max / qwen-turbo
SEARCH_API_KEY=your-search-api-key        # WebSearchTool 联网搜索（searchapi.io）
OLLAMA_BASE_URL=http://localhost:11434    # 本地 Ollama，无 key
MCP_SERVER_ENABLED=true                   # 是否启用 MCP 服务端（SSE）
TERMINAL_TOOL_ENABLED=false               # 终端工具默认关闭，生产保持 false 防止 RCE
NOTE_BASE_DIR=                            # 留空走默认 ${user.dir}/tmp/notes
